SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
CRON_SECRET=generate-a-long-random-secret

# Admin dashboard login (configure real values only in Render / local .env)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# At least 32 random characters. Use a distinct secret from CRON_SECRET.
ADMIN_SESSION_SECRET=

DSE_SOURCE_URL=https://old.dsebd.org/latest_share_price_scroll_by_ltp.php
HTTP_TIMEOUT_SECONDS=20
COLLECTOR_USER_AGENT=dse-market-data-collector/2.0
COLLECTOR_INTERVAL_SECONDS=120

MARKET_TIMEZONE=Asia/Dhaka
MARKET_OPEN=10:00
MARKET_CLOSE=14:10
MARKET_DAYS=6,0,1,2,3
ENFORCE_MARKET_WINDOW=true

LOCK_TTL_SECONDS=240
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2

# Agent 7: Instant Alert & Telegram Notification
# Create a bot via @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# Get your personal or channel chat ID via @userinfobot to set TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_ALERT_URL=
